# Copy to .env on the server (cp .env.example .env && chmod 600 .env) and fill in every value.
# Never commit the real .env.

# --- Images (Docker Hub) ---
DOCKERHUB_USER=your-dockerhub-username
# Pin an exact release tag in production (never "latest"), e.g. 1.0.0
FLEETOPS_VERSION=1.0.0

# --- Public address ---
# Domain whose DNS A record points at the VM's public IP
DOMAIN=fleetops.example.co.za
# Email for Let's Encrypt certificate notices
ACME_EMAIL=admin@example.co.za

# --- Database ---
DB_NAME=fleetops
DB_USERNAME=fleetops
# Generate: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
DB_PASSWORD=change-me

# --- Redis ---
# Generate: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
REDIS_PASSWORD=change-me

# --- Security ---
# At least 64 random characters. Generate: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=change-me

# --- Optional ---
FLEETOPS_TIMEZONE=Africa/Johannesburg
# SMTP for password-reset / verification emails (leave blank to disable)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
